{
  "name": "usion-archers-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Archers Arena — a turn-based 3D archery duel for the Usion platform",
  "scripts": {
    "dev": "vite --port 3017",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3017",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:compress": "node tools/compress-models.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.0",
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "@types/three": "^0.180.0",
    "jimp": "^0.22.12",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
